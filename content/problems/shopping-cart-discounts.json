{
  "id": "shopping-cart-discounts",
  "version": "2.0.0",
  "rubricId": "lld-core",
  "rubricVersion": "2.0.0",
  "title": "Shopping Cart & Discounts",
  "tier": 2,
  "minutes": 45,
  "domain": "commerce",
  "brief": "Design the class structure for a shopping cart that prices itself. Items go in, promotions apply, and a total comes out. The hard part is not the arithmetic — it is that the promotion rules change every week and are written by people who do not deploy code.",
  "requirements": [
    {
      "id": "r1",
      "text": "Items can be added and removed, with quantities",
      "conceptHints": [
        "domain-modeling"
      ],
      "keywords": [
        "add",
        "remove",
        "quantity",
        "lineitem",
        "line",
        "item"
      ]
    },
    {
      "id": "r2",
      "text": "The cart produces a total with a breakdown the customer can read",
      "conceptHints": [
        "immutability",
        "domain-modeling"
      ],
      "keywords": [
        "total",
        "breakdown",
        "receipt",
        "summary",
        "itemis",
        "explain",
        "readable"
      ]
    },
    {
      "id": "r3",
      "text": "Percentage-off and fixed-amount-off promotions are supported",
      "conceptHints": [
        "open-closed",
        "polymorphism"
      ],
      "keywords": [
        "percent",
        "fixed",
        "amount",
        "discount",
        "promotion",
        "offer",
        "coupon"
      ]
    },
    {
      "id": "r4",
      "text": "Some promotions apply to one line, others to the whole cart",
      "conceptHints": [
        "composition",
        "open-closed"
      ],
      "keywords": [
        "scope",
        "line",
        "cartwide",
        "wholecart",
        "perline",
        "applyto",
        "target",
        "level"
      ]
    },
    {
      "id": "r5",
      "text": "Tax is applied after discounts",
      "conceptHints": [
        "domain-modeling",
        "immutability"
      ],
      "keywords": [
        "tax",
        "vat",
        "gst",
        "levy"
      ]
    },
    {
      "id": "r6",
      "text": "Promotions that must not be combined are rejected rather than silently stacked",
      "conceptHints": [
        "error-modeling",
        "extensibility"
      ],
      "keywords": [
        "exclus",
        "conflict",
        "reject",
        "combin",
        "stack",
        "policy",
        "forbid",
        "incompatible",
        "resolve"
      ]
    }
  ],
  "constraints": [
    "Single currency",
    "Promotions are supplied as data, not compiled in",
    "The breakdown must explain every adjustment"
  ],
  "variationPoints": [
    {
      "id": "v1",
      "name": "discount rule",
      "why": "This is the axis that changes weekly, and by people who cannot ship code",
      "expectAbstraction": true,
      "acceptableShapes": [
        "interface",
        "abstract"
      ],
      "nameHints": [
        "discount",
        "promotion",
        "offer",
        "rule",
        "deal",
        "coupon"
      ]
    },
    {
      "id": "v2",
      "name": "rule combination order",
      "why": "Whether discounts stack, and in what order, is a policy that differs by market",
      "expectAbstraction": true,
      "acceptableShapes": [
        "interface",
        "abstract"
      ],
      "nameHints": [
        "combin",
        "resolv",
        "stack",
        "applicat",
        "pipeline",
        "policy",
        "engine"
      ]
    },
    {
      "id": "v3",
      "name": "tax strategy",
      "why": "Rates and rounding differ by jurisdiction, and inclusive-vs-exclusive pricing differs by market",
      "expectAbstraction": true,
      "acceptableShapes": [
        "interface",
        "abstract"
      ],
      "nameHints": [
        "tax",
        "vat",
        "gst",
        "levy"
      ]
    }
  ],
  "scenarios": [
    {
      "id": "sc-total",
      "title": "Two items, one 10%-off promotion, then tax",
      "description": "Two lines in the cart, a 10%-off promotion on one of them, tax applied afterwards. Walk through how the breakdown is produced.",
      "expectsFailurePath": false,
      "mustInvolve": [
        "discount",
        "promotion",
        "offer",
        "rule",
        "deal",
        "coupon",
        "percent",
        "fixed",
        "off"
      ]
    },
    {
      "id": "sc-scopes",
      "title": "A line promotion and a cart-wide promotion both apply",
      "description": "One promotion targets a single line; another is a fixed amount off the whole cart. Walk through who applies which, and in what order.",
      "expectsFailurePath": false,
      "mustInvolve": [
        "combin",
        "resolv",
        "stack",
        "applicat",
        "pipeline",
        "policy",
        "engine",
        "order"
      ]
    },
    {
      "id": "sc-conflict",
      "title": "Two promotions that must not be combined are both present",
      "description": "Both are valid on their own; together they are forbidden. Walk through who notices and how it ends.",
      "expectsFailurePath": true,
      "mustInvolve": []
    }
  ],
  "hiddenChanges": [
    {
      "id": "hc-b2g1",
      "prompt": "Marketing wants buy-two-get-one-free on selected items, plus a cart-wide coupon — and the two must never apply together. Whichever gives the customer the better price should win. Revise your design so it handles this — and say what you touched and why.",
      "targetsConcept": "open-closed",
      "mustIntroduce": [
        "buy",
        "bogo",
        "free",
        "bundle",
        "multibuy",
        "quantity",
        "coupon",
        "best",
        "compare",
        "cheap"
      ],
      "expectedSeam": "v1",
      "goodSignal": [
        "adds a new class implementing the existing discount abstraction",
        "the exclusivity decision lives in a combination or resolution policy, not inside a rule",
        "comparing outcomes is possible because pricing is a pure calculation",
        "existing promotions are untouched"
      ],
      "badSignal": [
        "adds a conditional inside the cart total method",
        "hardcodes the pair of conflicting promotions",
        "each rule is made aware of the others",
        "no mention of how the better price is chosen"
      ]
    },
    {
      "id": "hc-regions",
      "prompt": "Tax now depends on the delivery region, and in some regions tax is applied before discounts rather than after. Revise your design so it handles this — and say what you touched and why.",
      "targetsConcept": "open-closed",
      "mustIntroduce": [
        "region",
        "jurisdiction",
        "zone",
        "country",
        "locale",
        "state"
      ],
      "expectedSeam": "v3",
      "goodSignal": [
        "a new tax strategy per region behind an existing tax abstraction",
        "the ordering is a property of the strategy or the pipeline, not a branch in the cart"
      ],
      "badSignal": [
        "a region switch inside the total method",
        "tax logic copied per region"
      ]
    }
  ],
  "probes": [
    {
      "id": "p-rule",
      "prompt": "Marketing adds 'free shipping over 500'. Which class do you write, and does {{class}} have to change to run it?",
      "targetsConcept": "open-closed",
      "triggerWhen": {
        "criterionId": "abstraction-use",
        "maxScore": 2
      },
      "goodSignal": [
        "a new implementation of an existing promotion abstraction",
        "nothing existing changes"
      ],
      "badSignal": [
        "a new branch",
        "the cart changes"
      ]
    },
    {
      "id": "p-split",
      "prompt": "{{class}} both stores items and computes totals. If something else computed the totals, what would the 'breakdown the customer can read' requirement gain?",
      "targetsConcept": "srp",
      "triggerWhen": {
        "criterionId": "class-responsibilities",
        "maxScore": 2
      },
      "goodSignal": [
        "the breakdown becomes a value the calculation returns",
        "the cart stays a plain collection"
      ],
      "badSignal": [
        "nothing gained",
        "no split"
      ]
    },
    {
      "id": "p-conflict",
      "prompt": "Two promotions that must not combine are both in the cart. Which class notices, when, and what does the customer see?",
      "targetsConcept": "error-modeling",
      "triggerWhen": {
        "criterionId": "behaviour",
        "maxScore": 2
      },
      "goodSignal": [
        "one class owns the decision",
        "customer sees a named rejection"
      ],
      "badSignal": [
        "each promotion checks the others",
        "silently stacks",
        "no class named"
      ]
    },
    {
      "id": "p-money",
      "prompt": "Is a price a float in your design? Where does rounding happen, and how many places would you have to fix if it were wrong?",
      "targetsConcept": "encapsulation",
      "goodSignal": [
        "a money type",
        "rounding in one place"
      ],
      "badSignal": [
        "float is fine",
        "rounding everywhere"
      ]
    },
    {
      "id": "p-order",
      "prompt": "Tax is applied after discounts. Where in your design is that ordering decided, and how many places change if it flips?",
      "targetsConcept": "cohesion",
      "goodSignal": [
        "one place",
        "names it"
      ],
      "badSignal": [
        "scattered",
        "cannot say"
      ]
    }
  ],
  "conceptTags": [
    "open-closed",
    "extensibility",
    "immutability",
    "cohesion",
    "composition-over-inheritance"
  ],
  "commonFailureModes": [
    {
      "id": "f1",
      "name": "Discount type enum with a switch",
      "description": "A calculateTotal method branching on a DiscountType, so every new promotion edits it.",
      "concept": "open-closed",
      "frequency": "very-high"
    },
    {
      "id": "f2",
      "name": "Cart mutates its own totals",
      "description": "Totals as mutable fields updated in place, making the breakdown impossible to reconstruct.",
      "concept": "immutability",
      "frequency": "high"
    },
    {
      "id": "f3",
      "name": "Money as a float",
      "description": "Rounding errors and no place to express currency or precision.",
      "concept": "immutability",
      "frequency": "high"
    },
    {
      "id": "f4",
      "name": "Rules that know about each other",
      "description": "Exclusivity encoded inside individual promotions rather than in a combination policy.",
      "concept": "cohesion",
      "frequency": "medium"
    }
  ],
  "goldDesigns": {
    "strong": {
      "assumptions": [
