          "kind": "has-a"
        },
        {
          "from": "Adjustment",
          "to": "Money",
          "kind": "has-a"
        }
      ],
      "tradeoffs": "Pricing is a pure function from cart plus rules to a Breakdown, rather than totals mutated on the cart, so the same cart can be priced under two candidate rule sets and compared. Exclusivity lives in a policy rather than inside promotions, because a rule that knows about other rules has to change whenever the catalogue does.",
      "decisions": [
        {
          "what": "Pricing is a separate engine returning an immutable Breakdown",
          "alternative": "Cart.total() mutating running totals",
          "why": "The breakdown requirement needs every adjustment recorded, and comparing two outcomes needs pricing to be repeatable."
        },
        {
          "what": "Exclusivity is a CombinationPolicy",
          "alternative": "Each promotion lists what it conflicts with",
          "why": "Rules that know about each other grow quadratically; a policy is one place."
        },
        {
          "what": "Money is a fixed-precision value",
          "alternative": "float",
          "why": "Rounding has one owner, and percent-off is defined once."
        }
      ],
