            },
            {
              "className": "MoveValidator",
              "method": "validateMove",
              "note": "confirms cell is free"
            },
            {
              "className": "StandardBoard",
              "method": "placeMark",
              "note": "marks the cell"
            },
            {
              "className": "OutcomeEvaluator",
              "method": "evaluate",
              "note": "detects no win and board full"
            },
            {
              "className": "Game",
              "method": "placeMark",
              "note": "records draw"
            }
          ],
          "outcome": "ok"
        },
        {
          "scenarioId": "sc-invalid",
          "steps": [
            {
