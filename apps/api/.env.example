# Copy to .env.local (gitignored). The API loads .env.local at startup and never
# overrides variables already exported by the shell.

# Postgres. Locally: createdb lld_practice, then `npm run seed` applies the migrations.
DATABASE_URL="postgresql://YOUR_USER@localhost:5432/lld_practice"
# Tests use their own database (schemas are created per test file):
# LLD_TEST_DATABASE_URL="postgresql://YOUR_USER@localhost:5432/lld_practice_test"

# Optional — one of these makes a real model score the two read criteria
# (edge cases, reasoning). Without any, a deterministic heuristic stands in and
# the whole loop still works. See README "Running it" for the free tiers.
# GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=...
# OPENROUTER_API_KEY=...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides.
# LLD_LLM_PROVIDER=groq        # groq | gemini | openrouter | ollama | anthropic | stub
# LLD_LLM_MODEL=openai/gpt-oss-120b
# LLD_FORCE_STUB=1
# LLD_LLM_LOG_USAGE=1          # one JSON line per model call with token counts — how an attempt's cost was measured
